generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum FileKind {
  FILE
  DIRECTORY
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

model User {
  id             String              @id @default(uuid()) @db.Uuid
  firebaseUid    String              @unique @map("firebase_uid") @db.VarChar(128)
  email          String?             @db.VarChar(320)
  emailVerified  Boolean             @default(false) @map("email_verified")
  displayName    String?             @map("display_name") @db.VarChar(128)
  photoUrl       String?             @map("photo_url") @db.VarChar(2048)
  authProvider   String?             @map("auth_provider") @db.VarChar(64)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  ownedProjects  Project[]           @relation("ProjectOwner")
  memberships    ProjectMember[]
  fileVersions   FileVersion[]
  operations     DocumentOperation[]
  revisions      ProjectRevision[]
  builds         Build[]

  @@map("users")
}

model Project {
  id                       String            @id @default(uuid()) @db.Uuid
  ownerId                  String?           @map("owner_id") @db.Uuid
  name                     String            @db.VarChar(128)
  rootFile                 String            @default("main.tex") @map("root_file") @db.VarChar(1024)
  latestSuccessfulBuildId  String?           @map("latest_successful_build_id") @db.Uuid
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  legacyWorkspaceStatus    String            @default("retired") @map("workspace_status") @db.VarChar(32)
  legacyWorkspaceIdentifier String           @unique @default(uuid()) @map("workspace_identifier") @db.VarChar(255)
  owner                    User?             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members                  ProjectMember[]
  files                    FileEntry[]
  operations               DocumentOperation[]
  revisions                ProjectRevision[]
  builds                   Build[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model FileEntry {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @map("project_id") @db.Uuid
  path           String              @db.VarChar(1024)
  parentPath     String              @map("parent_path") @db.VarChar(1024)
  name           String              @db.VarChar(255)
  kind           FileKind
  mimeType       String?             @map("mime_type") @db.VarChar(255)
  currentVersion Int                 @default(0) @map("current_version")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       FileVersion[]
  operations     DocumentOperation[]
  revisionFiles  RevisionFile[]

  @@index([projectId, parentPath])
  @@index([projectId, path])
  @@map("file_entries")
}

model FileVersion {
  id          String         @id @default(uuid()) @db.Uuid
  fileEntryId String         @map("file_entry_id") @db.Uuid
  version     Int
  storageKey  String         @map("storage_key") @db.VarChar(1536)
  checksum    String         @db.Char(64)
  size        Int
  createdBy   String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  fileEntry   FileEntry      @relation(fields: [fileEntryId], references: [id], onDelete: Cascade)
  creator     User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  revisionFiles RevisionFile[]

  @@unique([fileEntryId, version])
  @@index([checksum])
  @@map("file_versions")
}

model DocumentOperation {
  id            String     @id @default(uuid()) @db.Uuid
  projectId     String     @map("project_id") @db.Uuid
  fileEntryId   String?    @map("file_entry_id") @db.Uuid
  actorId       String     @map("actor_id") @db.Uuid
  operationType String     @map("operation_type") @db.VarChar(64)
  baseVersion   Int?       @map("base_version")
  resultVersion Int?       @map("result_version")
  metadata      Json
  createdAt     DateTime   @default(now()) @map("created_at")
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileEntry     FileEntry? @relation(fields: [fileEntryId], references: [id], onDelete: SetNull)
  actor         User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("document_operations")
}

model ProjectRevision {
  id                 String         @id @default(uuid()) @db.Uuid
  projectId          String         @map("project_id") @db.Uuid
  sequence           Int
  rootFile           String         @map("root_file") @db.VarChar(1024)
  manifestStorageKey String         @map("manifest_storage_key") @db.VarChar(1536)
  createdBy          String         @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator            User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  files              RevisionFile[]
  builds             Build[]

  @@unique([projectId, sequence])
  @@index([projectId, createdAt])
  @@map("project_revisions")
}

model RevisionFile {
  revisionId  String          @map("revision_id") @db.Uuid
  fileEntryId String          @map("file_entry_id") @db.Uuid
  fileVersionId String        @map("file_version_id") @db.Uuid
  path        String          @db.VarChar(1024)
  storageKey  String          @map("storage_key") @db.VarChar(1536)
  checksum    String          @db.Char(64)
  size        Int
  revision    ProjectRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  fileEntry   FileEntry       @relation(fields: [fileEntryId], references: [id], onDelete: Restrict)
  fileVersion FileVersion     @relation(fields: [fileVersionId], references: [id], onDelete: Restrict)

  @@id([revisionId, fileEntryId])
  @@index([fileVersionId])
  @@map("revision_files")
}

model Build {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  revisionId        String          @map("revision_id") @db.Uuid
  requestedBy       String          @map("requested_by") @db.Uuid
  rootFile          String          @map("root_file") @db.VarChar(1024)
  status            BuildStatus     @default(QUEUED)
  queueJobId        String?         @map("queue_job_id") @db.VarChar(255)
  compiler          String          @default("latexmk") @db.VarChar(64)
  startedAt         DateTime?       @map("started_at")
  finishedAt        DateTime?       @map("finished_at")
  exitCode          Int?            @map("exit_code")
  durationMs        Int?            @map("duration_ms")
  pdfStorageKey     String?         @map("pdf_storage_key") @db.VarChar(1536)
  logStorageKey     String?         @map("log_storage_key") @db.VarChar(1536)
  synctexStorageKey String?         @map("synctex_storage_key") @db.VarChar(1536)
  errorSummary      Json?           @map("error_summary")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision          ProjectRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  requester         User            @relation(fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("builds")
}
