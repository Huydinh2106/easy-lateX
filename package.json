{
  "name": "easy-latex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @easy-latex/desktop",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "package": "npm run package --workspace @easy-latex/desktop",
    "make": "npm run make --workspace @easy-latex/desktop"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
