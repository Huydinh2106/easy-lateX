# Desktop public settings. Never put backend secrets in VITE_* variables.
EASY_LATEX_DOCKER_IMAGE=easy-latex-compiler:2026.09.15
EASY_LATEX_API_URL=http://127.0.0.1:4318
# Optional build-time public URL for apps opened directly from Finder.
EASY_LATEX_RELEASE_API_URL=
# Optional installed Developer ID identity for release signing on macOS.
# Without it, macOS builds use an ad-hoc signature for local testing only.
EASY_LATEX_MAC_SIGN_IDENTITY=

# Backend only. These are not embedded in desktop bundles.
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=4318
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:4318/auth/github/callback
GITHUB_PRIVATE_KEY_PATH=
# Cloud alternative: base64 of the PEM file, a secret (not encryption).
GITHUB_PRIVATE_KEY_BASE64=
# Generate with: openssl rand -base64 32; keep the key stable across restarts.
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=
# Optional operator setup wizard: HTTPS webhook target (a Smee URL for local tests).
GITHUB_SETUP_WEBHOOK_URL=

# Optional legacy migration bridge only. Leave empty for new installations.
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_ANON_KEY=
LEGACY_SUPABASE_SERVICE_KEY=
