# Public desktop settings. Backend credentials must never use VITE_* variables.
EASY_LATEX_DOCKER_IMAGE=easy-latex-compiler:2026.09.15
EASY_LATEX_API_URL=https://rukiacheotxmmrpeppyc.supabase.co/functions/v1/easy-latex-api
EASY_LATEX_RELEASE_API_URL=https://rukiacheotxmmrpeppyc.supabase.co/functions/v1/easy-latex-api
EASY_LATEX_MAC_SIGN_IDENTITY=

# Optional local API development only. Hosted Edge Functions receive their
# SUPABASE_URL, SUPABASE_DB_URL, ANON_KEY and SERVICE_ROLE_KEY automatically.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
API_HOST=127.0.0.1
API_PORT=4318

# Optional CLI initialization of a fresh cloud schema, not needed for redeploys.
# Use direct/session pooling, port 5432, with verified TLS. LISTEN needs a session.
EASY_LATEX_SUPABASE_PROJECT_REF=rukiacheotxmmrpeppyc
EASY_LATEX_CLOUD_DATABASE_URL=
EASY_LATEX_SUPABASE_CA_CERT=
