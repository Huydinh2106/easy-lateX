# Development works without Firebase credentials.
NODE_ENV=development
AUTH_MODE=development
POSTGRES_USER=latex
POSTGRES_PASSWORD=latex-development
POSTGRES_DB=latex_platform
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-development
S3_BUCKET=easy-latex

FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# For Firebase, use AUTH_MODE=firebase and configure both client settings and
# one Firebase Admin credential source.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON=

COMPILER_IMAGE=easy-latex-compiler:local
COMPILE_TIMEOUT_MS=120000
MAX_PROJECT_SOURCE_BYTES=52428800
MAX_COMPILE_LOG_BYTES=5242880
MAX_ARTIFACT_BYTES=52428800
