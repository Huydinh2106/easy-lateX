# Local-only credentials. Replace both values before starting the platform.
POSTGRES_USER=latex
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=latex_platform
CODE_SERVER_PASSWORD=replace-with-a-long-random-editor-password

# Browser-facing services.
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Dynamic code-server workspaces use this local port range.
WORKSPACE_IMAGE=latex-workspace:local
WORKSPACE_VOLUME_PREFIX=easy-latex-project
WORKSPACE_CONTAINER_PREFIX=easy-latex-workspace
WORKSPACE_BIND_HOST=127.0.0.1
WORKSPACE_PUBLIC_HOST=localhost
WORKSPACE_PORT_START=8100
WORKSPACE_PORT_END=8199

# Pinned workspace versions for reproducible builds.
CODE_SERVER_VERSION=4.135.0
LATEX_WORKSHOP_VERSION=10.18.0

# Optional full SQLAlchemy URL. Leave unset to use the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://latex:password@postgres:5432/latex_platform
