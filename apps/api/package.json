{
  "name": "@easy-latex/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "smoke": "tsx ../../scripts/github-smoke.mts",
    "smoke:webhook": "tsx ../../scripts/github-webhook-smoke.mts",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start:built": "node dist/index.js"
  },
  "dependencies": {
    "@easy-latex/shared-types": "*",
    "@supabase/supabase-js": "^2.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.2.0",
    "typescript": "^5.9.0",
    "eslint": "^9.36.0",
    "@eslint/js": "^9.36.0",
    "typescript-eslint": "^8.44.0",
    "esbuild": "^0.28.2"
  }
}
